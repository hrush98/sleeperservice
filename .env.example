# Core runtime
DATABASE_URL=postgresql+psycopg2://polymarket:polymarket@localhost:5432/polymarket

# External data
ODDS_API_KEY=
GOALSERVE_FEED_KEY=

# Polymarket HTTP / signing
POLY_API_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_CHAIN_ID=137
POLYMARKET_KEYFILE_PATH=~/.sleeperservice/keys/polymarket.key.age
LIVE_KILL_SWITCH_PATH=~/.sleeperservice/keys/STOP_TRADING

# Optional display / logging overrides
DISPLAY_TIMEZONE=America/Los_Angeles
LOG_DIR=logs

# Phase 0.5 historical research
# HISTORICAL_DATASET_ROOT=/absolute/path/to/prediction-markets-data
# HISTORICAL_RESEARCH_OUTPUT_ROOT=logs/historical_research
# Optional: sync promoted artifacts from an S3-compatible bucket such as Railway Bucket.
ARTIFACT_BUCKET_ENABLED=false
ARTIFACT_BUCKET_NAME=
ARTIFACT_BUCKET_PREFIX=
ARTIFACT_BUCKET_ENDPOINT_URL=
ARTIFACT_BUCKET_REGION=
ARTIFACT_BUCKET_ACCESS_KEY_ID=
ARTIFACT_BUCKET_SECRET_ACCESS_KEY=
ARTIFACT_BUCKET_SESSION_TOKEN=

# Public beta analysis API
API_PUBLIC_BETA_ENABLED=true
API_MAINTENANCE_MODE=false
API_MAINTENANCE_MESSAGE=SleeperService public beta is temporarily unavailable while maintenance is in progress.
API_AUTH_MODE=disabled
# Comma-separated key_id:secret[:tier] records. For public beta, set API_AUTH_MODE=api_key.
API_KEY_RECORDS=local-dev:change-me:beta
API_DEFAULT_RATE_LIMIT_PER_MINUTE=60
API_REQUEST_LOGGING_ENABLED=true
